<?xml version="1.0" encoding="UTF-8"?>
<eecas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-eca-3.xsd">
 <eeca id="NasqoImportedInvoicePostingReview" entity="mantle.account.invoice.Invoice"
       on-update="true" run-before="true" get-entire-entity="true" run-on-error="false">
  <condition><expression>statusId &amp;&amp; !(statusId in ['InvoiceInProcess','InvoiceIncoming','InvoiceCancelled'])</expression></condition>
  <actions>
   <entity-find entity-name="growerp.nasqo.AccountingImportDocument" list="nasqoImports">
    <econdition field-name="invoiceId"/>
   </entity-find>
   <if condition="nasqoImports.any { it.financialPostingApproved != 'Y' }">
    <script>throw new IllegalStateException('هذه مسودة مستوردة؛ يجب مراجعة مطابقة الحسابات والضرائب والتسويات قبل اعتمادها محاسبيًا.')</script>
   </if>
  </actions>
 </eeca>
 <eeca id="NasqoImportedPaymentPostingReview" entity="mantle.account.payment.Payment"
       on-update="true" run-before="true" get-entire-entity="true" run-on-error="false">
  <condition><expression>statusId &amp;&amp; !(statusId in ['PmntProposed','PmntCancelled'])</expression></condition>
  <actions>
   <entity-find entity-name="growerp.nasqo.AccountingImportPayment" list="nasqoPayments"><econdition field-name="paymentId"/></entity-find>
   <if condition="nasqoPayments.any { it.financialPostingApproved != 'Y' }">
    <script>throw new IllegalStateException('هذا سند مستورد للمراجعة؛ يلزم اعتماد الحساب المالي والتسوية قبل تنفيذه أو ترحيله.')</script>
   </if>
  </actions>
 </eeca>
 <eeca id="NasqoImportedPaymentApplicationReview" entity="mantle.account.payment.PaymentApplication"
       on-create="true" on-update="true" run-before="true" get-entire-entity="true" run-on-error="false">
  <actions>
   <entity-find entity-name="growerp.nasqo.AccountingImportPayment" list="nasqoPayments">
    <econditions combine="or"><econdition field-name="paymentId"/><econdition field-name="paymentId" from="toPaymentId" ignore-if-empty="true"/></econditions>
   </entity-find>
   <if condition="nasqoPayments.any { it.financialPostingApproved != 'Y' }">
    <script>throw new IllegalStateException('لا يمكن تسوية سند مستورد قبل اعتماد مراجعته المحاسبية.')</script>
   </if>
  </actions>
 </eeca>
</eecas>
