# Moqui native clients use api_key. Keep only this underscore header on HTTPS;
# Caddy rejects its ambiguous Api-Key alias and repeated values.
{
    servers :443 {
        expected_underscore_headers api_key
    }
}

# Automatic HTTPS requires a real DNS record and reachable ports 80 and 443.
{$NASQO_DOMAIN} {
    encode zstd gzip
    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "DENY"
        Strict-Transport-Security "max-age=31536000"
    }
    @api path /rest/* /rpc/* /status /vapps* /chat* /notws* /googleOAuth* /adk /adk/*
    reverse_proxy @api backend:80
    reverse_proxy web:80
}
