# Example only. Do NOT commit a real .env.
# Use a domain pointing to your hosting server (not *.github.dev).
NASQO_DOMAIN=erp.example.com
NASQO_REF=master
# The exact, reviewed commit of the selected NASQO_REF branch.
NASQO_COMMIT=
NASQO_IMAGE_TAG=1.0.0
# Generate two separate strong values and save ONLY in .env (gitignored).
NASQO_DB_PASSWORD=
NASQO_CRYPT_PASSWORD=


# NASQO Business OIDC Google sign-in. Create a separate confidential Web OAuth
# client in Google Cloud; never commit the actual secret in the repository.
# Redirect URI for the NASQO VPS: https://erp.indexesstore.com/googleOAuth/loginCallback
NASQO_GOOGLE_LOGIN_ENABLED=false
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT_URI=
