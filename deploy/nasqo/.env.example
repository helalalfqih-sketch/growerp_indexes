# Example only. Do NOT commit a real .env.
# Use a domain pointing to your hosting server (not *.github.dev).
NASQO_DOMAIN=erp.example.com
NASQO_REF=master
# The exact, reviewed commit of the selected NASQO_REF branch.
NASQO_COMMIT=
